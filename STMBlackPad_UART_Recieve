void setup() {
  pinMode(PC13, OUTPUT);
  digitalWrite(PC13, HIGH); // LED OFF at start

  Serial1.begin(9600); // UART1 → PA9 (TX), PA10 (RX)
}

void loop() {
  if (Serial1.available() > 0) {
    int data = Serial1.parseInt();
    if (data == 1){
     digitalWrite(PC13, LOW);  // LED ON when data received
    delay(500);
    digitalWrite(PC13, HIGH); // LED OFF after 500ms
    }
    
    
    
  }
}
